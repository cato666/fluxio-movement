{
  "id": "squat",
  "aliases": ["squat", "sentadilla", "back squat", "front squat"],
  "views": ["side", "front"],
  "required_landmarks": ["shoulder", "hip", "knee", "ankle"],
  "primary_signal": "knee_angle",
  "states": ["lockout", "descent", "bottom", "ascent"],
  "initial_state": "lockout",
  "bottom_state": "bottom",
  "transitions": [
    {"from": "lockout", "to": "descent", "signal": "knee_angle", "operator": "<=", "threshold": "descent_knee_max"},
    {"from": "descent", "to": "bottom", "signal": "knee_angle", "operator": "<=", "threshold": "bottom_knee_max"},
    {"from": "bottom", "to": "ascent", "signal": "knee_angle", "operator": ">=", "threshold": "ascent_knee_min"},
    {"from": "ascent", "to": "lockout", "signal": "knee_angle", "operator": ">=", "threshold": "lockout_knee_min", "completes_rep": true}
  ],
  "thresholds": {"descent_knee_max": 145.0, "bottom_knee_max": 115.0, "ascent_knee_min": 135.0, "lockout_knee_min": 155.0},
  "metrics": ["knee_angle", "hip_angle", "trunk_from_vertical"],
  "noise": {"min_confirm_frames": 2, "max_gap_s": 0.5, "min_rep_duration_s": 0.35, "max_rep_duration_s": 12.0, "cooldown_s": 0.25}
}
