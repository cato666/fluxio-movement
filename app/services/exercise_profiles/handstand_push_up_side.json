{
  "id": "handstand-push-up-side",
  "aliases": [
    "Flexión invertida (en pino)",
    "Flexión invertida",
    "flexion invertida",
    "flexiones en pino",
    "handstand push-up",
    "handstand push up",
    "hspu"
  ],
  "views": [
    "side"
  ],
  "required_landmarks": [
    "shoulder",
    "elbow",
    "wrist",
    "hip",
    "ankle"
  ],
  "primary_signal": "elbow_angle",
