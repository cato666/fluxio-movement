# PRIVATE VALUES MUST BE CONFIGURED BY GASTON. This template contains none.
BACKUP_RUNNER_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
BACKUP_DAILY_TIME=03:00
BACKUP_SCHEDULE_TIMEZONE=America/Santiago
BACKUP_STATE_PATH=/state
BACKUP_WORK_PATH=/work
STORAGE_PATH=/source/storage
BACKUP_AES_KEY_FILE=/run/secrets/aes256.key
BACKUP_AES_KEY_ID=REQUIRED_APPROVED_KEY_VERSION
BACKUP_PG_SERVICE=fluxio_backup
PGSERVICEFILE=/run/secrets/pg_service.conf
PGPASSFILE=/run/secrets/pgpass
BACKUP_QUIESCENCE_FILE=/control/maintenance.json
BACKUP_SOURCE_COMMIT=REQUIRED_FULL_COMMIT
BACKUP_MAX_SET_BYTES=536870912
BACKUP_COMMAND_TIMEOUT_SECONDS=600
BACKUP_STALE_HOURS=24
BACKUP_MAX_RUN_SECONDS=1800
R2_ENDPOINT=REQUIRED_PRIVATE_HTTPS_ENDPOINT
R2_BUCKET=fluxio-movement-backups
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_ALERT_TIMEOUT_SECONDS=10
TELEGRAM_ALERT_MIN_INTERVAL_SECONDS=60
TELEGRAM_ALERT_DAILY_LIMIT=20

# Offline remains the default. Online requires verified deployed writers.
BACKUP_CAPTURE_MODE=offline
BACKUP_MEDIA_PROTOCOL=immutable-v1
BACKUP_ONLINE_WRITERS_VERIFIED=false
BACKUP_APPLICATION_STORAGE_PATH=/data/storage
