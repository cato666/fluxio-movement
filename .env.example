APP_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
DEMO_PASSWORD=demo1234
POSTGRES_DB=movement
POSTGRES_USER=movement
POSTGRES_PASSWORD=change-this-before-deploying
DATABASE_URL=postgresql+psycopg://movement:change-this-before-deploying@db:5432/movement
STORAGE_PATH=/data/storage
MAX_UPLOAD_MB=250
APP_PORT=8000
OPENAI_API_KEY=
AI_REASONING_ENABLED=true
AI_REASONING_MODEL=gpt-5.6-terra
AI_REASONING_EFFORT=medium
TRAINING_AI_ENABLED=true
# Vacío utiliza AI_REASONING_MODEL. Debe admitir imágenes y salida estructurada.
TRAINING_AI_MODEL=
TRAINING_VOICE_ENABLED=true
TRAINING_TRANSCRIPTION_MODEL=gpt-transcribe
# WhatsApp is disabled by default. Use separate sandbox credentials/keys.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=kapso
# Sandbox: set WHATSAPP_ENABLED=true only in the isolated validation environment.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=
# Validation URL inventory; currently not consumed by the application.
PUBLIC_BASE_URL=
# Requested name, currently NOT consumed. Runtime requires WHATSAPP_ENCRYPTION_KEY below.
# Do not configure PHONE_ENCRYPTION_KEY alone; see docs/whatsapp/KAPSO_SANDBOX_CHECKLIST.md.
PHONE_ENCRYPTION_KEY=
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_KEY_VERSION=1
# Optional JSON keyring for decrypting older key versions during rotation.
WHATSAPP_ENCRYPTION_KEYS={}
PHONE_HASH_KEY=
# Blank means unknown cost, not zero. USD per accepted outbound message.
WHATSAPP_OUTBOUND_UNIT_COST_USD=

# Public WhatsApp destination for the linking UI (international digits, not provider ID).
WHATSAPP_PUBLIC_NUMBER=
# Enlaces de semana compartida: máximo 168 horas, revocables por el atleta.
WEEKLY_SHARE_TOKEN_TTL_HOURS=168
