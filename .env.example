APP_ENV=production
# Generate SESSION_SECRET with a cryptographic random generator (at least 32 characters).
SESSION_SECRET=
ENABLE_DEMO_SEED=false
# Development only: APP_ENV=development, ENABLE_DEMO_SEED=true and an explicit DEMO_PASSWORD.
DEMO_PASSWORD=
POSTGRES_DB=movement
POSTGRES_USER=movement
POSTGRES_PASSWORD=
# Set DATABASE_URL explicitly, using the configured database credentials.
DATABASE_URL=
STORAGE_PATH=/data/storage
MAX_UPLOAD_MB=250
APP_PORT=8000
OPENAI_API_KEY=
AI_REASONING_ENABLED=true
AI_REASONING_MODEL=gpt-5.6-terra
AI_REASONING_EFFORT=medium
TRAINING_AI_ENABLED=true
# Vacío utiliza AI_REASONING_MODEL. Debe admitir imágenes y salida estructurada.
TRAINING_AI_MODEL=
TRAINING_VOICE_ENABLED=true
TRAINING_TRANSCRIPTION_MODEL=gpt-transcribe
# WhatsApp is disabled by default. Use separate sandbox credentials/keys.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=kapso
# Sandbox: set WHATSAPP_ENABLED=true only in the isolated validation environment.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=
# Validation URL inventory; currently not consumed by the application.
PUBLIC_BASE_URL=
# Requested name, currently NOT consumed. Runtime requires WHATSAPP_ENCRYPTION_KEY below.
# Do not configure PHONE_ENCRYPTION_KEY alone; see docs/whatsapp/KAPSO_SANDBOX_CHECKLIST.md.
PHONE_ENCRYPTION_KEY=
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_KEY_VERSION=1
# Optional JSON keyring for decrypting older key versions during rotation.
WHATSAPP_ENCRYPTION_KEYS={}
PHONE_HASH_KEY=
# Blank means unknown cost, not zero. USD per accepted outbound message.
WHATSAPP_OUTBOUND_UNIT_COST_USD=

# Public WhatsApp destination for the linking UI (international digits, not provider ID).
WHATSAPP_PUBLIC_NUMBER=
# Enlaces de semana compartida: máximo 168 horas, revocables por el atleta.
WEEKLY_SHARE_TOKEN_TTL_HOURS=168

# S06: production requires every core limit plus PILOT_START (YYYY-MM-DD UTC).
# Controlled admin configuration can override these and records an audit event.
# Provisional reservation estimates, NOT actual provider tariffs or a guarantee.
USAGE_INTERPRET_DAILY=3
USAGE_TRANSCRIBE_DAILY=3
USAGE_ANALYZE_DAILY=1
USAGE_WHATSAPP_INBOUND_DAILY=20
USAGE_WHATSAPP_OUTBOUND_DAILY=20
USAGE_WHATSAPP_RATE_PER_CONVERSATION=5
USAGE_VIDEO_CONCURRENT=1
USAGE_GLOBAL_DAILY_USD=3
USAGE_GLOBAL_PILOT_USD=30
USAGE_ALERT_PERCENT=80
USAGE_INTERPRET_RESERVE_USD=0.05
USAGE_TRANSCRIBE_RESERVE_USD=0.03
USAGE_ANALYZE_RESERVE_USD=0.20
USAGE_WHATSAPP_SEND_RESERVE_USD=0.02
USAGE_PILOT_START=
# Required explicitly for video in production, even if a component is nonbillable.
# Empty means BLOCKED; assess compute/storage/other costs before assigning values.
USAGE_VIDEO_COMPUTE_RESERVE_USD=
USAGE_VIDEO_STORAGE_RESERVE_USD=
USAGE_VIDEO_OTHER_RESERVE_USD=
